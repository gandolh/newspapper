{
  "name": "@newspapper/api",
  "version": "3.0.0",
  "description": "Newspapper Fastify HTTP API server.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "node --conditions=newspapper-built dist/server.js",
    "seed": "tsx --env-file-if-exists=../.env src/seed.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.3",
    "@fastify/type-provider-zod": "1.0.3",
    "@newspapper/core": "*",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "openapi-types": "12.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "tsx": "4.22.1"
  }
}
