{
  "name": "@newspapper/api",
  "version": "3.0.0",
  "description": "Newspapper Fastify HTTP API server.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx --env-file-if-exists=../.env src/seed.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.5",
    "@newspapper/core": "*",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "tsx": "4.22.1"
  }
}
