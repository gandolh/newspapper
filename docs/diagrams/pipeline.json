      "sublabel": "ready to upload",
      "stage": 4,
      "row": 3
    }
  ],
  "flows": [
    {
      "id": "f-rss",
      "from": "rss",
      "to": "library",
      "label": "save what is useful",
      "classification": "reading, not ingesting",
      "variant": "dashed",
      "labelAt": [
        208,
        542
      ]
    },
    {
      "id": "f-quote",
      "from": "library",
      "to": "source",
      "label": "quote into a post",
      "classification": "by hand",
      "variant": "dashed",
      "labelAt": [
        315,
        590
      ]
    },
    {
      "id": "f-parse",
      "from": "source",
      "to": "parse",
      "label": "the markup",
      "classification": "authored",
      "variant": "emphasis"
    },
    {
      "id": "f-html",
      "from": "parse",
      "to": "html",
      "label": "slide model",
      "classification": "themed",
      "variant": "emphasis"
    },
    {
      "id": "f-img",
      "from": "uploads",
      "to": "chromium",
      "label": "served from disk",
      "classification": "no HTTP fetch",
      "variant": "security"
    },
    {
      "id": "f-shot",
      "from": "html",
      "to": "chromium",
      "label": "load and screenshot",
      "classification": "one per slide",
      "variant": "emphasis",
      "labelAt": [
        745,
        200
      ]
    },
    {
      "id": "f-out",
      "from": "chromium",
      "to": "jpegs",
      "label": "encode",
      "classification": "1080 × 1080",
      "variant": "emphasis"
    },
    {
      "id": "f-ship",
      "from": "jpegs",
      "to": "ship",
      "label": "download or post",
      "classification": "final",
      "labelAt": [
        960,
        314
      ]
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "The slide is a DOM first",
      "items": [
        "Compiling produces real HTML with the theme applied, not a drawing",
        "Chromium screenshots that page, so what ships is what a browser rendered",
        "Which means a slide can be inspected in devtools while it is being designed"
      ]
    },
    {
      "dot": "cyan",
      "title": "RSS is a library, not a pipeline",
      "items": [
        "Feeds are searched by keyword and useful items are saved",
        "A post is written by a person quoting from that library",
        "Nothing turns a feed item into a post automatically, by decision"
      ]
    },
    {
      "dot": "rose",
      "title": "Images are removed, not authorised",
      "items": [
        "Chromium carries no cookie, so /uploads/* used to be public to feed it",
        "The render context already served fonts from disk; images now go the same way",
        "So the request never leaves the process — no new credential exists"
      ]
    }
  ]
}
