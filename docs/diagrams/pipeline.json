{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "From .wzd source to uploadable slides",
    "viewBox": [
      1080,
      760
    ],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "compile",
        "label": "The compile path",
        "focus": [
          "source",
          "parse",
          "html",
          "chromium",
          "jpegs"
        ],
        "note": "The slide is a real DOM before it is an image; the screenshot is taken of that."
      },
      {
        "id": "material",
        "label": "RSS is source material",
        "focus": [
          "rss",
          "library",
          "source"
        ],
        "note": "Feeds are a library to write FROM — deliberately not a pipeline that produces a post."
      },
      {
        "id": "assets",
        "label": "Where images come from",
        "focus": [
          "uploads",
          "chromium"
        ],
        "note": "The render context serves images from disk rather than fetching them over HTTP."
      }
    ]
  },
  "stages": [
    {
      "label": "Gather"
    },
    {
      "label": "Write"
    },
    {
      "label": "Compile"
    },
    {
      "label": "Render"
    },
    {
      "label": "Ship"
    }
  ],
  "nodes": [
    {
      "id": "rss",
      "type": "external",
      "label": "RSS feeds",
      "sublabel": "searched by keyword",
      "stage": 0,
      "row": 3,
      "tag": "not a pipeline"
    },
    {
      "id": "library",
      "type": "database",
      "label": "Saved items",
      "sublabel": "source material",
      "stage": 1,
      "row": 3
    },
    {
      "id": "source",
      "type": "frontend",
      "label": ".wzd document",
      "sublabel": "written by a person",
      "stage": 1,
      "row": 0,
      "tag": "the input"
    },
    {
      "id": "parse",
      "type": "backend",
      "label": "Compile",
      "sublabel": "markup → slide model",
      "stage": 2,
      "row": 0
    },
    {
      "id": "uploads",
      "type": "database",
      "label": "Uploads",
      "sublabel": "images on disk",
      "stage": 2,
      "row": 3
    },
    {
      "id": "html",
      "type": "backend",
      "label": "HTML + theme",
      "sublabel": "a real 1080² DOM",
      "stage": 3,
      "row": 0,
      "tag": "the artwork"
    },
    {
      "id": "chromium",
      "type": "backend",
      "label": "Headless Chromium",
      "sublabel": "screenshots each slide",
      "stage": 3,
      "row": 2
    },
    {
      "id": "jpegs",
      "type": "database",
      "label": "1080² JPEGs",
      "sublabel": "plus a caption",
      "stage": 4,
      "row": 1,
      "tag": "the output"
    },
    {
      "id": "ship",
      "type": "external",
