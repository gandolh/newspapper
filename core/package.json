{
  "name": "@newspapper/core",
  "version": "3.0.0",
  "description": "Newspapper pipeline library — scrape, compose, storage.",
  "type": "module",
  "exports": {
    ".": {
      "newspapper-built": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./templates": {
      "newspapper-built": "./dist/templates/index.js",
      "default": "./src/templates/index.ts"
    },
    "./publish": {
      "newspapper-built": "./dist/publish/index.js",
      "default": "./src/publish/index.ts"
    },
    "./wizard": {
      "newspapper-built": "./dist/wizard/index.js",
      "default": "./src/wizard/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "dotenv": "17.4.2",
    "fflate": "0.8.3",
    "playwright": "1.60.0",
    "rss-parser": "3.13.0",
    "sharp": "0.35.5"
  }
}
