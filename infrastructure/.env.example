# Copy to `infrastructure/.env` (git-ignored) before `docker compose up`.
#
# Read twice: compose interpolates ${...} in docker-compose.yml from it, and the
# service declares it as env_file so the same values reach the process.

# Published on 127.0.0.1 only, and the port the service listens on.
PORT=3001

# Where the app is served from, baked into the UI bundle at BUILD time (a
# compose build arg, not a runtime variable — see infrastructure/Dockerfile).
# Leave unset for a standalone run at the origin root; the VPS deploy sets
# /newspapper/ because Caddy serves it under that prefix.
# NEWSPAPPER_BASE=/newspapper/

# Host paths for the two bind mounts. Defaults are the repo's own dirs, which is
# right for a local run; on the VPS these point at /srv/newspapper/*.
# NEWSPAPPER_DATA_DIR=/srv/newspapper/data
# NEWSPAPPER_OUTPUT_DIR=/srv/newspapper/output
# These are HOST paths, read by compose only. The app has its own OUTPUT_DIR /
# UPLOADS_DIR for paths inside the container; leave OUTPUT_DIR unset here, the
# image already writes to /app/output, which is where the mount lands.

# ---------------------------------------------------------------------------
# Ward. All three are REQUIRED — the server refuses to boot without them.
# ---------------------------------------------------------------------------
WARD_PUBLIC_ORIGIN=https://gandolh.ro
WARD_API_BASE_PATH=/ward-api
# Issue in Ward's console (the newspapper app's "Service keys"). Shown ONCE.
WARD_APP_KEY=wak_replace_me
