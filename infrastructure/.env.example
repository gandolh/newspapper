# Copy to `infrastructure/.env` (git-ignored) before `docker compose up`.
#
# Read twice: compose interpolates ${...} in docker-compose.yml from it, and the
# service declares it as env_file so the same values reach the process.

# Published on 127.0.0.1 only, and the port the service listens on.
PORT=3001

# Where the app is served from. Baked into the UI bundle at BUILD time (a
# compose build arg — see infrastructure/Dockerfile) AND read by the API at
# runtime for the session cookie's Path, so it must be in this file for a
# sub-path deploy. Leave unset for a standalone run at the origin root; the VPS
# deploy sets /newspapper/ because Caddy serves it under that prefix.
# NEWSPAPPER_BASE=/newspapper/

# Host paths for the two bind mounts. Defaults are the repo's own dirs, which is
# right for a local run; on the VPS these point at /srv/newspapper/*.
# NEWSPAPPER_DATA_DIR=/srv/newspapper/data
# NEWSPAPPER_OUTPUT_DIR=/srv/newspapper/output
# These are HOST paths, read by compose only. The app has its own OUTPUT_DIR /
# UPLOADS_DIR for paths inside the container; leave OUTPUT_DIR unset here, the
# image already writes to /app/output, which is where the mount lands.

# ---------------------------------------------------------------------------
# "Sign in with Ward" (optional; local accounts work without it).
# With WARD_OIDC_ISSUER unset the app runs on local accounts alone. With it set,
# all of the next three are required. Create the first account with the seed
# script (SEED_USERNAME / SEED_PASSWORD in the shell, never in this file).
# ---------------------------------------------------------------------------
WARD_OIDC_ISSUER=https://example.com/ward-api/oidc
WARD_OIDC_CLIENT_ID=newspapper
# The app's Ed25519 private key (base64url JWK). A SECRET: set it on the host
# only. Ward's `npm run oidc-client-key` prints the pair.
WARD_OIDC_CLIENT_KEY=
# As the browser reaches it, under the app's base; registered at Ward exactly.
WARD_OIDC_REDIRECT_URI=https://example.com/newspapper/api/auth/ward/callback
WARD_OIDC_POST_LOGOUT_REDIRECT_URI=https://example.com/newspapper/

# The session cookie's Path comes from NEWSPAPPER_BASE above, which the API
# reads at runtime. It must be set here for a sub-path deploy, not only exported
# for the build.
