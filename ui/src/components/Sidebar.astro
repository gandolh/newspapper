---
/**
 * The tray.
 *
 * A full-width 78px strip across the top of the board, closed by a 1.5px
 * graphite rule and divided into compartments by 1px rules. Every compartment
 * is a **showing**: it renders the thing the route produces — a board inside
 * crop marks, a stack of boards, a column of clippings, a scale-chip row —
 * with a 9px mono caption under it. You pick a route by recognising its shape.
 *
 * The current compartment is the one pulled forward: it takes paper and the
 * waxed shadow, the same mark a selected node takes (DESIGN.md §5). No fill,
 * no accent colour, no pill.
 *
 * `transition:persist` keeps the strip mounted across view transitions so it
 * never flashes and the health probe never restarts.
 */
import ApiHealthDot from './ApiHealthDot';
import SessionMenu from './auth/SessionMenu';

const navLinks = [
  { href: '/', caption: 'Editor', showing: 'board' },
  { href: '/posts', caption: 'Posts', showing: 'stack' },
  { href: '/articles', caption: 'Articles', showing: 'clipping' },
  { href: '/settings', caption: 'Settings', showing: 'chips' },
];

const path = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<nav class="tray" aria-label="Main navigation" transition:persist="sidebar">
  <div class="cell cell--brand">
    <a href="/" class="brand" aria-label="newspapper home">
      <span class="brand-name">newspapper</span>
      <span class="brand-caption">paste-up board</span>
    </a>
  </div>

  <ul class="cells" role="list">
    {navLinks.map(({ href, caption, showing }) => (
      <li class="cell-item">
        <a
          href={href}
          class:list={['cell', 'cell--nav', { 'cell--current': isActive(href) }]}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          <span class="showing" aria-hidden="true">
            {showing === 'board' && (
              <svg viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1">
                <path d="M6 3v3M3 6h3M24 3v3M27 6h-3M6 27v-3M3 24h3M24 27v-3M27 24h-3" />
                <rect x="8" y="8" width="14" height="14" stroke-width="1.5" />
                <path d="M11 13h8M11 17h5" stroke-width="1.5" />
              </svg>
            )}
            {showing === 'stack' && (
              <svg viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1">
                <rect x="3" y="9" width="12" height="12" />
                <rect x="9" y="6" width="12" height="12" />
                <rect x="15" y="3" width="12" height="12" stroke-width="1.5" />
              </svg>
            )}
            {showing === 'clipping' && (
              <svg viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 6h24M3 11h18M3 16h21M3 21h11" />
                <path d="M20 23l4 4M24 23l-4 4" stroke-width="1" />
              </svg>
            )}
            {showing === 'chips' && (
              <svg viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1">
                <rect x="2" y="11" width="7" height="8" />
                <rect x="11.5" y="11" width="7" height="8" fill="currentColor" />
                <rect x="21" y="11" width="7" height="8" />
              </svg>
            )}
          </span>
          <span class="caption">{caption}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="cell cell--session">
    <SessionMenu client:load />
    <ApiHealthDot client:load />
  </div>
</nav>

<style>
  .tray {
    display: flex;
    align-items: stretch;
    width: 100%;
    height: var(--tray-h);
    background: var(--board);
    border-bottom: 1.5px solid var(--graphite);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .cells {
    display: flex;
    align-items: stretch;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
  }

  .cell-item {
    display: flex;
  }

  .cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-hair);
    padding: 0 var(--sp-half);
    border-right: 1px solid var(--rule);
    color: var(--graphite);
    text-decoration: none;
    flex-shrink: 0;
  }

  .cell--brand {
    justify-content: center;
    padding: 0 var(--sp-unit);
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: var(--graphite);
  }

  .brand-name {
    font-family: var(--font-chrome);
    font-size: var(--fs-brand);
    font-weight: 800;
    font-variation-settings: 'wdth' var(--wdth-brand);
    letter-spacing: var(--ls-brand);
    text-transform: uppercase;
    line-height: 1.2;
  }

  .brand-caption {
    font-family: var(--font-galley);
    font-size: var(--fs-field);
    font-weight: 500;
    letter-spacing: var(--ls-field);
    text-transform: uppercase;
    color: var(--graphite-soft);
  }

  .cell--nav {
    align-items: center;
    width: 104px; /* 4 × 26 */
    color: var(--graphite-soft);
  }

  .cell--nav:hover {
    color: var(--graphite);
  }

  /* The compartment pulled forward: paper, waxed down. */
  .cell--current {
    background: var(--paper);
    box-shadow: var(--shadow-waxed);
    color: var(--graphite);
  }

  .showing {
    display: block;
    width: 30px;
    height: 30px;
  }

  .showing svg {
    width: 30px;
    height: 30px;
  }

  .caption {
    font-family: var(--font-galley);
    font-size: var(--fs-field);
    font-weight: 500;
    letter-spacing: var(--ls-field);
    text-transform: uppercase;
  }

  .cell--current .caption {
    font-weight: 700;
    color: var(--graphite);
  }

  .cell--session {
    margin-left: auto;
    border-right: 0;
    border-left: 1px solid var(--rule);
    justify-content: center;
    gap: var(--sp-hair);
    padding: 0 var(--sp-half);
    min-width: calc(var(--sp-unit) * 6);
  }

  @media (max-width: 768px) {
    .cell--brand {
      padding: 0 var(--sp-half);
    }
    .brand-caption {
      display: none;
    }
    .cell--nav {
      width: 78px; /* 3 × 26 */
    }
  }
</style>
