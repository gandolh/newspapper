---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';

const { title = 'newspapper', width = 'default' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fbfbf9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — newspapper</title>
    <ClientRouter />
  </head>
  <body>
    <div class="board">
      <!-- The tray: a full-width strip across the top of the board. -->
      <Sidebar />

      <main class="work">
        <div
          class:list={['sheet', { 'sheet--fluid': width === 'fluid' }]}
          transition:animate="none"
        >
          <slot />
        </div>
      </main>
    </div>

    <style>
      .board {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      /* The working area, ruled off the tray by one grid unit. */
      .work {
        flex: 1;
        min-width: 0;
        padding: var(--sp-unit);
      }

      /* Every sheet lands on the same column, and the column is a whole
         number of grid units wide (The One Grid Rule). Fluid sheets — the
         editor — take the board. */
      .sheet {
        max-width: var(--content-max);
        margin-inline: auto;
      }

      .sheet--fluid {
        max-width: none;
      }

      @media (max-width: 768px) {
        .work {
          padding: var(--sp-half);
        }
      }
    </style>
  </body>
</html>
