# API server port (default 3001)
PORT=3001

# ---------------------------------------------------------------------------
# Authentication (single account)
# ---------------------------------------------------------------------------

# HMAC key for the session cookie. Required outside development — the server
# refuses to start without it. Generate one with: openssl rand -hex 32
# Minimum 16 characters. Changing it signs everyone out.
SESSION_SECRET=

# The one account, created on first boot only (when the users table is empty).
# Changing these later does nothing — use the app to change the password.
# Minimum password length: 8. Required outside development.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional overrides
# THEME=warm-industrial
# NEWSPAPPER_DB_PATH=./data/newspapper.db

# Where uploaded images live. An absolute path puts the store outside the repo;
# a relative one resolves against the repo root, never the cwd. Defaults to
# <repo>/uploads.
UPLOADS_DIR=

# Origin the render browser fetches /uploads/<ref> from. Defaults to
# http://127.0.0.1:$PORT — set it only if the renderer cannot reach the API on
# loopback.
UPLOADS_BASE_URL=
