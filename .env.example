# Every variable below is read by code. If you add one here, add its reader in
# the same change — a settable variable that changes nothing costs the next
# person an afternoon. See corpus/wiki/configuration.md.

# API server port (default 3001). Also the origin the compiled slides name for
# /uploads/* and /assets/fonts/* — both of which the renderer serves from disk
# rather than fetching. See UPLOADS_BASE_URL below.
PORT=3001

# ---------------------------------------------------------------------------
# Ward (the estate's identity service)
# ---------------------------------------------------------------------------
#
# SESSION_SECRET, ADMIN_USERNAME and ADMIN_PASSWORD are GONE. Newspapper holds
# no account, no password hash and no session secret: identity is Ward's, at one
# login page for the whole estate. The single admin account is now an ordinary
# Ward account holding a `newspapper` grant, created from Ward's console.
#
# All three below are REQUIRED. The server refuses to boot without them,
# because a missing one is a total outage — Ward refuses every unkeyed
# introspection, so every guarded route would 503 — rather than a degraded
# mode, and failing at startup is far cheaper to diagnose.

# Ward's public origin. Also the exact `iss` every access token must carry.
# Bare origin, no trailing slash.
WARD_PUBLIC_ORIGIN=https://gandolh.ro

# Ward's prefix behind Caddy. `/ward-api` in this estate.
#
# No default, deliberately: an empty value resolves the JWKS to
# <origin>/.well-known/jwks.json, a path nothing serves — which would make
# newspapper reject every token, with a clean log, on the deploy that shipped it.
WARD_API_BASE_PATH=/ward-api

# Newspapper's own Ward service key. A SECRET — server-side only, never logged.
#
# Issue it in Ward's console: the newspapper app's page, "Service keys". It is
# shown ONCE and cannot be read back. If it is lost, issue a new one and revoke
# the old one — which is also the rotation procedure.
WARD_APP_KEY=wak_replace_me

# Optional overrides
# THEME=warm-industrial-1
# NEWSPAPPER_DB_PATH=./data/newspapper.db

# Where uploaded images live. An absolute path puts the store outside the repo;
# a relative one resolves against the repo root, never the cwd. Defaults to
# <repo>/uploads.
UPLOADS_DIR=

# Origin the render browser resolves /uploads/<ref> against. Defaults to
# http://127.0.0.1:$PORT.
#
# Note that since the Ward cutover the render browser does not actually FETCH
# this: `core/src/render/uploads-route.ts` intercepts the request inside the
# browser context and serves the bytes from disk, which is what let /uploads/*
# become a guarded route. The URL still has to be well-formed — it is what the
# compiled slide's CSS `url()` contains — but nothing listens on it during a
# render.
UPLOADS_BASE_URL=
